[Unit]
Description=Expecto Academy booking backup
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/expecto-api
ExecStart=/opt/node-v22/bin/node --disable-warning=ExperimentalWarning server/backup.mjs
EnvironmentFile=/etc/expecto-api.env
User=expecto
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/expecto-api
PrivateTmp=true
